{
  "manifest_version": 3,
  "name": "fastget Download Catcher",
  "version": "0.5.0",
  "description": "Send browser downloads to the fastget app for fast multi-connection downloading, pause/resume, and a download list. Requires the free fastget app for Windows.",
  "homepage_url": "https://github.com/alphaxt/fastget",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "fastget",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fastget@fastget.addon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
