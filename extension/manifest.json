{
  "manifest_version": 3,
  "name": "fastget Download Catcher",
  "version": "0.4.0",
  "description": "Catches downloads in the browser and hands them to the fastget engine for fast multi-connection downloading.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "fastget",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fastget@fastget.addon",
      "strict_min_version": "109.0"
    }
  }
}
